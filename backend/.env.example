# Copy to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL 16) ---
DB_URL=jdbc:postgresql://localhost:5432/cinebook
# App role: DML only (SELECT/INSERT/UPDATE/DELETE)
DB_APP_USERNAME=cinebook_app
DB_APP_PASSWORD=cinebook_app
# Migrator role: schema owner, used only by Flyway
DB_MIGRATOR_USERNAME=cinebook_migrator
DB_MIGRATOR_PASSWORD=cinebook_migrator

# --- JWT HS256 (Base64, >= 256-bit). Generate: openssl rand -base64 48 ---
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# --- QR ticket signing (HMAC-SHA256, Base64). Generate: openssl rand -base64 48 ---
QR_HMAC_KEY=

# --- Cloudinary: cloudinary://<api_key>:<api_secret>@<cloud_name> ---
CLOUDINARY_URL=
